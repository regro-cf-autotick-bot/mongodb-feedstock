From b7f208068ee4a6bbb09f88f695607bcefcbb8583 Mon Sep 17 00:00:00 2001
From: tropicrainforest <tropicrainforest27017@gmail.com>
Date: Thu, 18 Jun 2026 23:08:27 +0200
Subject: [PATCH 1/6] Disable mongo_apple_toolchain registration for native
 macOS builds

The mongo_apple_toolchain (bazel/toolchains/cc/mongo_apple/
mongo_apple_toolchain.bzl) requires LLVM 19 + lld 19 installed via Homebrew
(brew --prefix llvm@19); failure is unconditional fail(), no skip-env hatch.
Homebrew is not available in conda-forge CI by policy, and we want to build
with conda-forge's own clang anyway. Removing the registration here causes
Bazel's macOS native autodetect (@local_config_cc//:cc-compiler-darwin_*)
to win toolchain resolution, conda-forge's $CC is then used directly.
---
 MODULE.bazel | 6 ------
 1 file changed, 6 deletions(-)

diff --git a/MODULE.bazel b/MODULE.bazel
index 240ed7af4..432079184 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -246,12 +246,6 @@ register_execution_platforms("@internal_platforms_do_not_use//host:host")
 ##    "mongo_toolchain_v5",
 ##)
 #
-setup_mongo_apple_toolchains_extension = use_extension("//bazel/toolchains/cc/mongo_apple:mongo_apple_toolchain.bzl", "setup_mongo_apple_toolchain_extension")
-use_repo(setup_mongo_apple_toolchains_extension, "mongo_apple_toolchain")
-
-register_toolchains(
-    "@mongo_apple_toolchain//...",
-)
 
 setup_mongo_python_toolchains = use_extension("//bazel:bzlmod.bzl", "setup_mongo_python_toolchains")
 use_repo(
