From e9071898fc1ef2d1a5d25cf05c2981bb9d1baca2 Mon Sep 17 00:00:00 2001
From: tropicrainforest <tropicrainforest27017@gmail.com>
Date: Thu, 18 Jun 2026 23:10:46 +0200
Subject: [PATCH 4/7] Make tool_to_path basename check tolerate cross-prefixed
 compilers

tool_to_path() derives the C++ compiler from the C compiler by an exact
basename match (gcc->g++, clang->clang++, wrapped_clang->wrapped_clang_pp).
conda-forge ships cross-prefixed compilers (e.g.
x86_64-conda-linux-gnu-gcc, powerpc64le-conda-linux-gnu-gcc), so the exact
match never fires and CXX cannot be resolved. Match with endswith() and
keep the cross prefix when swapping the suffix; wrapped_clang is checked
first because it also ends with "clang".
---
 src/mongo/util/version_constants_gen.py | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/src/mongo/util/version_constants_gen.py b/src/mongo/util/version_constants_gen.py
index b83243f2132..02be62984b2 100644
--- a/src/mongo/util/version_constants_gen.py
+++ b/src/mongo/util/version_constants_gen.py
@@ -36,12 +36,16 @@ def tool_to_path(tool, compiler_path):
     if tool == "CC":
         return compiler_path
     elif tool == "CXX":
-        if os.path.basename(compiler_path) == "gcc":
-            return os.path.join(os.path.dirname(compiler_path), "g++")
-        elif os.path.basename(compiler_path) == "clang":
-            return os.path.join(os.path.dirname(compiler_path), "clang++")
-        elif os.path.basename(compiler_path) == "wrapped_clang":
-            return os.path.join(os.path.dirname(compiler_path), "wrapped_clang_pp")
+        basename = os.path.basename(compiler_path)
+        # Use endswith() to accept cross-prefixed compiler names like
+        # conda-forge's "x86_64-conda-linux-gnu-gcc". Order matters:
+        # "wrapped_clang" endswith "clang", so check it first.
+        if basename.endswith("wrapped_clang"):
+            return os.path.join(os.path.dirname(compiler_path), basename[:-len("wrapped_clang")] + "wrapped_clang_pp")
+        elif basename.endswith("clang"):
+            return os.path.join(os.path.dirname(compiler_path), basename[:-len("clang")] + "clang++")
+        elif basename.endswith("gcc"):
+            return os.path.join(os.path.dirname(compiler_path), basename[:-len("gcc")] + "g++")
         else:
             return
 
