From 8ce3b665b75a306afc80ad9792f9e7e93fa67c4e Mon Sep 17 00:00:00 2001
From: tropicrainforest <tropicrainforest27017@gmail.com>
Date: Sun, 7 Jun 2026 16:54:34 +0200
Subject: [PATCH 19/28] exec/near: define SearchResult in the header so
 priority_queue sees a complete type

The near-query executor header declared a std::priority_queue<SearchResult>
member while SearchResult was only forward-declared above it, and a priority_queue
needs a complete element type at instantiation (clang-19 / libc++ 22).
---
 src/mongo/db/exec/near.cpp | 15 ---------------
 src/mongo/db/exec/near.h   | 13 ++++++++++++-
 2 files changed, 12 insertions(+), 16 deletions(-)

diff --git a/src/mongo/db/exec/near.cpp b/src/mongo/db/exec/near.cpp
index 05bc2735..f48623bc 100644
--- a/src/mongo/db/exec/near.cpp
+++ b/src/mongo/db/exec/near.cpp
@@ -114,21 +114,6 @@ PlanStage::StageState NearStage::doWork(WorkingSetID* out) {
     return nextState;
 }
 
-/**
- * Holds a generic search result with a distance computed in some fashion.
- */
-struct NearStage::SearchResult {
-    SearchResult(WorkingSetID resultID, double distance) : resultID(resultID), distance(distance) {}
-
-    bool operator<(const SearchResult& other) const {
-        // We want increasing distance, not decreasing, so we reverse the <
-        return distance > other.distance;
-    }
-
-    WorkingSetID resultID;
-    double distance;
-};
-
 // Set "toReturn" when NEED_YIELD.
 PlanStage::StageState NearStage::bufferNext(WorkingSetID* toReturn) {
     //
diff --git a/src/mongo/db/exec/near.h b/src/mongo/db/exec/near.h
index 315b7c8f..aeb58666 100644
--- a/src/mongo/db/exec/near.h
+++ b/src/mongo/db/exec/near.h
@@ -179,7 +179,18 @@ private:
     IntervalStats* _nextIntervalStats;
 
     // Sorted buffered results to be returned - the current interval
-    struct SearchResult;
+    struct SearchResult {
+        SearchResult(WorkingSetID resultID, double distance)
+            : resultID(resultID), distance(distance) {}
+
+        bool operator<(const SearchResult& other) const {
+            // We want increasing distance, not decreasing, so we reverse the <
+            return distance > other.distance;
+        }
+
+        WorkingSetID resultID;
+        double distance;
+    };
     std::priority_queue<SearchResult> _resultBuffer;
 
     // Stats
