From 1ff61f03874f8fc926bd3467bf9ed3152d84824f Mon Sep 17 00:00:00 2001
From: tropicrainforest <tropicrainforest27017@gmail.com>
Date: Thu, 18 Jun 2026 23:13:28 +0200
Subject: [PATCH 7/7] resharding_util: split deeply-nested pipeline literals to
 avoid MSVC C1060

createOplogFetchingPipelineForResharding builds two deeply nested
Doc/Arr/Value brace-initializer literals (the $or match and the
$cond/$filter/$and $addFields). MSVC's front-end exhausts its heap while
expanding each single large expression tree and aborts with C1060 (out of
heap space); Since this is a front-end limit, so codegen flags such as /Od do
not help.
---
 src/mongo/db/s/resharding/resharding_util.cpp | 57 ++++++++++---------
 1 file changed, 29 insertions(+), 28 deletions(-)

diff --git a/src/mongo/db/s/resharding/resharding_util.cpp b/src/mongo/db/s/resharding/resharding_util.cpp
index ac9a97e2042..ff7da96e5e6 100644
--- a/src/mongo/db/s/resharding/resharding_util.cpp
+++ b/src/mongo/db/s/resharding/resharding_util.cpp
@@ -297,21 +297,26 @@ std::unique_ptr<Pipeline, PipelineDeleter> createOplogFetchingPipelineForReshard
     stages.emplace_back(DocumentSourceMatch::create(
         Doc{{"ts", Doc{{"$gte", startAfter.getTs()}}}}.toBson(), expCtx));
 
-    stages.emplace_back(DocumentSourceMatch::create(
-        Doc{{"$or",
-             // Only capture CRUD operations relevant for the `destinedRecipient`.
-             Arr{V{Doc{{"op", Doc{{"$in", Arr{V{"i"_sd}, V{"u"_sd}, V{"d"_sd}, V{"n"_sd}}}}},
-                       {"ui", collUUID},
-                       {"destinedRecipient", recipientShard.toString()}}},
-                 // Capture all commands. One cannot determine if a command is relevant to the
-                 // `destinedRecipient` until after oplog chaining via `prevOpTime` is resolved.
-                 V{Doc{{"op", "c"_sd},
+    // Only capture CRUD operations relevant for the `destinedRecipient`.
+    Doc crudClause{{"op", Doc{{"$in", Arr{V{"i"_sd}, V{"u"_sd}, V{"d"_sd}, V{"n"_sd}}}}},
+                   {"ui", collUUID},
+                   {"destinedRecipient", recipientShard.toString()}};
+    // Capture all commands. One cannot determine if a command is relevant to the
+    // `destinedRecipient` until after oplog chaining via `prevOpTime` is resolved.
+    Doc applyOpsClause{{"op", "c"_sd},
                        {"o.applyOps", EXISTS},
                        {"o.partialTxn", DNE},
-                       {"o.prepare", DNE}}},
-                 V{Doc{{"op", "c"_sd}, {"o.commitTransaction", EXISTS}}},
-                 V{Doc{{"op", "c"_sd}, {"o.abortTransaction", EXISTS}}},
-                 V{Doc{{"op", "c"_sd}, {"ui", collUUID}}}}}}
+                       {"o.prepare", DNE}};
+    Doc commitClause{{"op", "c"_sd}, {"o.commitTransaction", EXISTS}};
+    Doc abortClause{{"op", "c"_sd}, {"o.abortTransaction", EXISTS}};
+    Doc uiClause{{"op", "c"_sd}, {"ui", collUUID}};
+    stages.emplace_back(DocumentSourceMatch::create(
+        Doc{{"$or",
+             Arr{V{crudClause},
+                 V{applyOpsClause},
+                 V{commitClause},
+                 V{abortClause},
+                 V{uiClause}}}}
             .toBson(),
         expCtx));
 
@@ -348,22 +353,18 @@ std::unique_ptr<Pipeline, PipelineDeleter> createOplogFetchingPipelineForReshard
     // Filter out anything inside of an `applyOps` specifically destined for another shard. This
     // ensures zone restrictions are obeyed. Data will never be sent to a shard that it isn't meant
     // to end up on.
-    stages.emplace_back(DocumentSourceAddFields::create(
-        Doc{{"o.applyOps",
-             Doc{{"$cond",
+    Doc uiEq{{"$eq", Arr{V{"$$this.ui"_sd}, V{collUUID}}}};
+    Doc destinedEq{
+        {"$eq", Arr{V{"$$this.destinedRecipient"_sd}, V{recipientShard.toString()}}}};
+    Doc andSpec{{"$and", Arr{V{uiEq}, V{destinedEq}}}};
+    Doc filterSpec{
+        {"$filter", Doc{{"input", "$o.applyOps"_sd}, {"cond", andSpec}}}};
+    Doc condSpec{{"$cond",
                   Doc{{"if", Doc{{"$eq", Arr{V{"$op"_sd}, V{"c"_sd}}}}},
-                      {"then",
-                       Doc{{"$filter",
-                            Doc{{"input", "$o.applyOps"_sd},
-                                {"cond",
-                                 Doc{{"$and",
-                                      Arr{V{Doc{{"$eq", Arr{V{"$$this.ui"_sd}, V{collUUID}}}}},
-                                          V{Doc{{"$eq",
-                                                 Arr{V{"$$this.destinedRecipient"_sd},
-                                                     V{recipientShard.toString()}}}}}}}}}}}}},
-                      {"else", "$o.applyOps"_sd}}}}}}
-            .toBson(),
-        expCtx));
+                      {"then", filterSpec},
+                      {"else", "$o.applyOps"_sd}}}};
+    stages.emplace_back(DocumentSourceAddFields::create(
+        Doc{{"o.applyOps", condSpec}}.toBson(), expCtx));
 
     return Pipeline::create(std::move(stages), expCtx);
 }
