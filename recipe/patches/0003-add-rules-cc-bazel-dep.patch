From 3f92df8c3812d56a4441e51f315cd4565f2cf5ff Mon Sep 17 00:00:00 2001
From: tropicrainforest <tropicrainforest27017@gmail.com>
Date: Thu, 18 Jun 2026 23:09:43 +0200
Subject: [PATCH 3/7] Add explicit rules_cc bazel_dep for apparent-name
 resolution

The conda-forge bazel-toolchain (gen-bazel-toolchain) emits a BUILD file
that loads @rules_cc//cc/toolchains:cc_toolchain.bzl. Under bzlmod that
apparent repo name only resolves if rules_cc is a declared module, but
mongo's MODULE.bazel pulls rules_cc in only transitively, so the load
fails once the generated toolchain package is added to the build.
Declare rules_cc explicitly (0.0.16, matching the transitive version).
---
 MODULE.bazel | 1 +
 1 file changed, 1 insertion(+)

diff --git a/MODULE.bazel b/MODULE.bazel
index 75a416912e8..c3b4e43403e 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -1,6 +1,7 @@
 # Apple cc toolchain needs to be loaded before regular cc toolchain or else Apple will just use regular cc toolchain
 bazel_dep(name = "apple_support", version = "1.17.1", repo_name = "build_bazel_apple_support")
 bazel_dep(name = "bazel_features", version = "1.37.0")
+bazel_dep(name = "rules_cc", version = "0.0.16")
 
 bazel_features_deps = use_extension("//bazel:bzlmod.bzl", "bazel_features_deps")
 use_repo(bazel_features_deps, "bazel_features_globals", "bazel_features_version")
