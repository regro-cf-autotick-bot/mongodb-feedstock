From acaf658fd02e8c92bcbe0b0811fa9f4dd747e1fa Mon Sep 17 00:00:00 2001
From: Nehal J Wani <nehaljw.kkd1@gmail.com>
Date: Sun, 7 Jun 2026 16:54:31 +0200
Subject: [PATCH 03/28] Make SCons inherit environment vars

Co-authored-by: tropicrainforest <tropicrainforest27017@gmail.com>
---
 SConstruct | 1 +
 1 file changed, 1 insertion(+)

diff --git a/SConstruct b/SConstruct
index 3b6afd49..16e5d92d 100644
--- a/SConstruct
+++ b/SConstruct
@@ -1699,6 +1699,7 @@ if get_option('build-tools') == 'next':
     SCons.Tool.DefaultToolpath.insert(0, os.path.abspath('site_scons/site_tools/next'))
 
 env = Environment(variables=env_vars, **envDict)
+env.Append(ENV = os.environ)
 del envDict
 env.AddMethod(lambda env, name, **kwargs: add_option(name, **kwargs), 'AddOption')
 
